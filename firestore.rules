rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Everything is denied unless a rule below allows it.
    // Only the Python server (Admin SDK, which ignores these rules) touches other collections.

    // A signed-in user may create and read their own profile, nothing else.
    // Roles must never be stored here: the user writes this document themselves.
    match /users/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;

      allow create: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'phone', 'created_at'])
        && request.resource.data.keys().hasAll(['name', 'created_at'])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 80
        && (!('phone' in request.resource.data)
            || (request.resource.data.phone is string
                && request.resource.data.phone.matches('^[+0-9 ()-]{6,20}$')))
        && request.resource.data.created_at == request.time;
    }
  }
}
