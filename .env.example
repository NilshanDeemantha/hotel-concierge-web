# Base URL of the Python API. Public: it is built into the site, so never put a secret here.
NEXT_PUBLIC_API_URL=https://asia-south1-thambili-bay-concierge.cloudfunctions.net

# Optional, local testing only. With the emulators from the server repository running
# (firebase emulators:start), use these two lines instead of the one above:
# NEXT_PUBLIC_API_URL=http://127.0.0.1:5001/thambili-bay-concierge/asia-south1
# NEXT_PUBLIC_AUTH_EMULATOR_URL=http://127.0.0.1:9099
